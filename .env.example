# Configuración de Base de Datos y Aplicación
# Copiar este archivo a .env y ajustar los valores

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/multicont_db

# ============================================
# FLASK CONFIGURATION
# ============================================
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Entorno: development, production, testing
FLASK_ENV=development

# Archivo de entrada de la aplicación
FLASK_APP=run.py

# Activar modo debug (solo en desarrollo)
FLASK_DEBUG=1

# ============================================
# SQLALCHEMY CONFIGURATION
# ============================================
# Mostrar queries SQL en consola (solo desarrollo)
SQLALCHEMY_ECHO=False

# Deshabilitar tracking de modificaciones (mejor performance)
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ============================================
# API CONFIGURATION
# ============================================
# Puerto de la aplicación
PORT=5000

# Host (0.0.0.0 para acceso externo, 127.0.0.1 solo local)
HOST=127.0.0.1

# ============================================
# PAGINATION DEFAULTS
# ============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ============================================
# SECURITY (JWT AUTHENTICATION)
# ============================================
# IMPORTANTE: Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-IN-PRODUCTION

# Duración de tokens JWT (en horas para access, días para refresh)
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30

# ============================================
# CORS (Frontend Configuration)
# ============================================
# URLs permitidas para CORS (separadas por coma)
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
