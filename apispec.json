          "500": {
            "description": "Error del servidor"
          }
        },
        "summary": "Elimina un usuario",
        "tags": [
          "Usuarios"
        ]
      },
      "get": {
        "parameters": [
          {
            "description": "ID del usuario a buscar",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado"
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "500": {
            "description": "Error del servidor"
