  "info": {
    "contact": {
      "name": "Multicont Development Team"
    },
    "description": "API RESTful para sistema de gesti\u00f3n empresarial con arquitectura en capas",
    "title": "API Multicont - Clean Architecture",
    "version": "2.0.0"
  },
  "paths": {
    "/api/dashboard/": {
      "get": {
        "parameters": [
          {
            "default": "month",
            "description": "Per\u00edodo de tiempo para las m\u00e9tricas",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ],
            "in": "query",
            "name": "period",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Datos completos del dashboard",
            "schema": {
              "properties": {
                "data": {
                  "properties": {
                    "charts": {
                      "description": "Datos para gr\u00e1ficos",
                      "type": "object"
                    },
                    "recent_activity": {
                      "description": "Actividad reciente",
                      "type": "array"
                    },
                    "summary": {
                      "description": "Resumen de m\u00e9tricas principales",
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "success": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          }
        },
        "summary": "Obtiene datos consolidados para el dashboard principal",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/dashboard/kpis": {
      "get": {
        "summary": "Obtiene KPIs (Key Performance Indicators) del negocio",
        "tags": [
          "Dashboard"
        ]
      }
    },
    "/api/metrics/employees": {
      "get": {
        "summary": "Obtiene m\u00e9tricas de empleados",
        "tags": [
          "M\u00e9tricas"
        ]
      }
    },
    "/api/metrics/inventory": {
      "get": {
        "summary": "Obtiene m\u00e9tricas de inventario",
        "tags": [
          "M\u00e9tricas"
        ]
      }
    },
    "/api/metrics/sales": {
      "get": {
        "summary": "Obtiene m\u00e9tricas de ventas",
        "tags": [
          "M\u00e9tricas"
        ]
      }
    },
    "/api/metrics/summary": {
      "get": {
        "responses": {
          "200": {
            "description": "Resumen completo de m\u00e9tricas del sistema"
          }
        },
        "summary": "Obtiene un resumen de todas las m\u00e9tricas principales",
        "tags": [
          "M\u00e9tricas"
        ]
      }
    },
    "/api/metrics/users": {
      "get": {
        "responses": {
          "200": {
            "description": "Estad\u00edsticas de usuarios",
            "schema": {
              "properties": {
                "data": {
                  "properties": {
                    "active_users": {
                      "type": "integer"
                    },
                    "growth_last_month": {
                      "type": "integer"
                    },
                    "inactive_users": {
                      "type": "integer"
                    },
                    "suspended_users": {
                      "type": "integer"
                    },
                    "total_users": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "success": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          }
        },
        "summary": "Obtiene m\u00e9tricas de usuarios",
        "tags": [
          "M\u00e9tricas"
        ]
      }
    },
    "/api/users/": {
      "get": {
        "parameters": [
          {
            "default": 1,
            "description": "N\u00famero de p\u00e1gina",
            "in": "query",
            "name": "page",
            "type": "integer"
          },
          {
            "default": 10,
            "description": "Usuarios por p\u00e1gina",
            "in": "query",
            "name": "per_page",
            "type": "integer"
          },
          {
            "description": "Filtrar por estado",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ],
            "in": "query",
            "name": "status",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuarios con informaci\u00f3n de paginaci\u00f3n",
            "schema": {
              "properties": {
                "data": {
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "total_pages": {
                      "type": "integer"
                    },
                    "users": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "success": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "500": {
            "description": "Error del servidor"
          }
        },
        "summary": "Consulta todos los usuarios con paginaci\u00f3n",
        "tags": [
          "Usuarios"
        ]
      },
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "password": {
                  "example": "secreto123",
                  "type": "string"
                },
                "role_id": {
                  "example": 1,
                  "type": "integer"
                },
                "status": {
                  "default": "active",
                  "enum": [
                    "active",
                    "inactive",
                    "suspended"
                  ],
                  "type": "string"
                },
                "username": {
                  "example": "juan",
                  "type": "string"
                }
              },
              "required": [
                "username",
                "password",
                "role_id"
              ],
              "type": "object"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente"
          },
          "400": {
            "description": "Datos inv\u00e1lidos o usuario ya existe"
          },
          "500": {
            "description": "Error del servidor"
          }
        },
        "summary": "Crea un nuevo usuario",
        "tags": [
          "Usuarios"
        ]
      }
    },
    "/api/users/active": {
      "get": {
        "parameters": [
          {
            "default": 1,
            "in": "query",
            "name": "page",
            "type": "integer"
          },
          {
            "default": 10,
            "in": "query",
            "name": "per_page",
