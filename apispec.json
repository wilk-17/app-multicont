                },
                "success": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "500": {
            "description": "Error del servidor"
          }
        },
        "summary": "Obtiene estad\u00edsticas de usuarios",
        "tags": [
          "Usuarios"
        ]
      }
    },
